rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, with PUBLISHER_UID replaced by the id
// of the publisher account (Authentication → Users, "User UID"), then Publish. Everyone may read
// the stats; only that account, signed in from the debug build's New stats button, may write
// or delete them. Anything not matched here is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /stats/{statId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'PUBLISHER_UID';
    }
  }
}
